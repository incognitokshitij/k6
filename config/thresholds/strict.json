{
  "description": "Tight SLOs with abort-on-fail. Used for prod.",
  "thresholds": {
    "http_req_failed": [{ "threshold": "rate<0.005", "abortOnFail": true, "delayAbortEval": "10s" }],
    "http_req_duration": ["p(95)<500", "p(99)<1000"],
    "checks": ["rate>0.995"],
    "api_success_rate": ["rate>0.995"],
    "api_errors": ["count<5"]
  }
}
